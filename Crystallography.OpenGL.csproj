<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 260725Cl 削除: <AssemblyVersion>/<FileVersion> の静的値 (旧値 2026.7.6.0242)。
         VS 拡張 Automatic Versions がビルド毎に書き換えるだけの行で、出荷物には一切使われていなかった:
         ① release.yml / build-arm64-portable.yml / validate-wix-msi.yml の全 managed publish が
            -p:AssemblyVersion=<UTCタイムスタンプ> -p:FileVersion=<同> を注入し、この値を必ず上書きする
            (ProjectReference にも伝播することを実測確認: 4 アセンブリすべてが注入値になる)
         ② AssemblyVersion / FileVersion を読む C# コードは存在しない (バージョン表示・更新チェックは
            Version.cs の History 由来。ProgramUpdates は GitHub の Version.cs を raw 取得して比較)
         ③ WiX が使うのは Version.cs 由来の ProductVersion のみ
         ⚠CI 側の FileVersion 注入は廃止不可 — 欠くと MSI のファイルバージョン規則で自前アセンブリの
           FileCopy が costing 段階で省略され、アップグレード時にファイルが欠落する (release.yml の実証記録)。
         この行が復活していたら Automatic Versions が再インストールされている。 -->
    <!-- <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion> --><!-- 260405Cl .NET 10はWindows7非対応のため削除 -->
    <Platforms>x64</Platforms>
    <!--
    <TieredCompilation>false</TieredCompilation>
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    -->
    <!-- (260402Ch) 起動後の実行性能を重視して tiered compilation と dynamic PGO を有効化し、QuickJit 系は既定値へ戻す -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="6.0.0-beta2" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="SimdLinq" Version="1.3.2" />
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crystallography\Crystallography.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Using Include="SimdLinq" />
  </ItemGroup>

</Project>
